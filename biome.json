{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": true,
		"includes": ["**", "!.scratch", "!**/*.diagram.svg", "!packages/diagrams/test/golden"]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"lineWidth": 100
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"correctness": {
				"useImportExtensions": "error"
			},
			"style": {
				"useImportType": "error",
				"noEnum": "error",
				"noNamespace": "error",
				"noParameterProperties": "error",
				"noCommonJs": "error",
				"noRestrictedImports": {
					"level": "error",
					"options": {
						"paths": {
							"@resvg/resvg-js": "Only the CLI may use resvg: it's MPL-2.0, which the spec allows only for an unmodified dependency of the CLI."
						}
					}
				}
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"markdown": {
		"parser": {
			"frontmatter": true
		}
	},
	"plugins": [
		{
			"path": "./packages/diagrams/biome/exact-arithmetic.grit",
			"includes": ["packages/diagrams/src/core/**"]
		}
	],
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"overrides": [
		{
			"includes": ["packages/diagrams/src/cli/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": "off"
					}
				}
			}
		},
		{
			"includes": [
				"packages/diagrams/src/index.ts",
				"packages/diagrams/src/authoring/**",
				"packages/diagrams/src/notations/**",
				"packages/diagrams/src/core/**"
			],
			"linter": {
				"rules": {
					"correctness": {
						"noNodejsModules": "error",
						"noProcessGlobal": "error"
					}
				}
			}
		}
	]
}
