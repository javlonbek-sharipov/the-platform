{
	"name": "the-platform",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@12.16.1",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"prepare": "lefthook install",
		"test": "vitest run",
		"golden:update": "DIAGRAMS_UPDATE_GOLDEN=1 vitest run",
		"bench": "node packages/diagrams/scripts/benchmark.ts",
		"check": "biome check",
		"docs:dev": "pnpm --filter @the-platform/docs run dev",
		"docs:build": "pnpm --filter @the-platform/docs run build",
		"typecheck": "tsc -p . && tsc -p tsconfig.browser.json && pnpm --filter @the-platform/docs run sync && tsc -p apps/docs",
		"generate:font-metrics": "node packages/diagrams/scripts/generate-font-metrics.ts",
		"generate:schema": "node packages/diagrams/scripts/generate-schema.ts",
		"generate:technologies": "node packages/diagrams/scripts/generate-technologies.ts"
	},
	"dependencies": {
		"@the-platform/diagrams": "workspace:*"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.4",
		"@types/node": "^24.19.2",
		"@vitest/browser-playwright": "5.1.0",
		"ajv": "^8.20.0",
		"lefthook": "^2.2.2",
		"playwright": "1.64.1",
		"typescript": "^7.0.2",
		"vitest": "^5.1.0"
	}
}
